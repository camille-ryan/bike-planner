# Bulk data — fetched/generated by the ingest container
/data/

# Scenicness raster overlays — large PNGs (40-80 MB each) produced by
# `scenicness-bake --export-rasters` and copied to web/public/data/
# for the dev UI. Re-bake to regenerate.
/web/public/data/scenicness/*.png

# Landcover vector overlay (~25 MB GeoJSON) — generated by exporting
# the `landcover` table; regenerate rather than tracking the artifact.
/web/public/data/landcover_corridor.geojson
/web/public/data/ecoregions_europe.geojson

# Python
__pycache__/
*.pyc
*.pyo

# OS / editor cruft
.DS_Store
*.swp
*~

# Local Claude config (personal overrides — bypass mode etc.)
.claude/settings.local.json
