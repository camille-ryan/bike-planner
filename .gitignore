# Bulk data — fetched/generated by the ingest container
/data/

# Generated web overlay data (scenicness PNGs, route compare GeoJSONs,
# rail/lodging/city-route GeoJSONs, landcover/ecoregion exports, etc.).
# All produced by the bake/recompute/export pipelines; re-bake to
# regenerate. A couple of small reference files (e.g.
# graz_wien_compare.geojson, scenicness/manifest.json) were checked in
# pre-V3 and stay tracked; new generated files in this folder won't.
/web/public/data/

# Pipeline run logs (master-*, iv-*, restitch-*, etc.)
/logs/

# One-shot exploration / experiment scripts that aren't part of the
# baked pipeline. Keep locally; not core to the V2 codebase.
/run_experiments*.sh
/pgrouting/leithagebirge_breakdown.py
/pgrouting/test_seeding.py

# Python
__pycache__/
*.pyc
*.pyo

# OS / editor cruft
.DS_Store
*.swp
*~

# Local Claude config — personal permission allowlists, plan files,
# bypass-mode overrides. Nothing here is needed by other users of the
# repo.
.claude/

# API secrets — ANTHROPIC_API_KEY etc. Ship api/.env.example for the
# shape; keep the real values local.
api/.env

# MCP server build artifacts (from `pip install -e mcp_server`)
mcp_server/*.egg-info/
mcp_server/build/
mcp_server/dist/
